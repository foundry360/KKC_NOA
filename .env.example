# FHIR NOA Accelerator — environment template
# Copy to .env.local and fill values. Never commit real secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Inbound FHIR listener authentication (POC API key)
FHIR_INGEST_API_KEY=dev-ingest-key-change-me

# Optional REST destination for delivery demos
REST_DESTINATION_URL=
REST_DESTINATION_API_KEY=

# Optional: force default contract business id
# DEFAULT_NOA_CONTRACT=MEDICARE_NOA_MOCK_V1

# Persistence: when SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set, the
# ingest runtime uses Supabase repositories (and upserts POC seed config).
# Without them, process-local in-memory stores are used (tests / offline demo).

# App
NEXT_PUBLIC_APP_NAME=FHIR NOA Accelerator
