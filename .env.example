# FHIR NOA Accelerator — environment template
# Copy to .env.local and fill values. Never commit real secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Inbound FHIR listener authentication (POC API key)
FHIR_INGEST_API_KEY=dev-ingest-key-change-me

# Optional REST destination for delivery demos
REST_DESTINATION_URL=
REST_DESTINATION_API_KEY=

# Optional: force default contract business id
# DEFAULT_NOA_CONTRACT=MEDICARE_NOA_MOCK_V1

# Meridian Clinical (mock EHR) → NOA Accelerator
# Leave NOA_ACCELERATOR_URL unset to call the in-process pipeline (recommended locally).
# NOA_ACCELERATOR_URL=https://your-noa-host/api/fhir/r4/events
# MERIDIAN_DEMO_MODE=true
# Meridian persists patients/encounters/FHIR events to Supabase (meridian_* tables)
# when SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set. Force in-memory with:
# MERIDIAN_STORE=memory

# Meridian Clinical → Salesforce Admission__c (via Supabase Edge Function)
# Meridian calls the Edge Function server-side using SUPABASE_URL +
# SUPABASE_SERVICE_ROLE_KEY above. Optional override of the function URL:
# SALESFORCE_SUBMIT_FUNCTION_URL=https://YOUR_PROJECT.supabase.co/functions/v1/submit-admission-to-salesforce
#
# Salesforce credentials are NOT configured here. They exist only as Supabase
# Edge Function secrets (see docs/MERIDIAN_SALESFORCE_INTEGRATION.md):
#   SF_CLIENT_ID_hlsDev=<set via `supabase secrets set`>
#   SF_CLIENT_SECRET_hlsDev=<set via `supabase secrets set`>
#   SF_API_VERSION=v67.0
#   SF_LOGIN_BASE_URL=https://extraordinary-astro-253310-dev-ed.develop.my.salesforce.com

# Persistence: when SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set, the
# ingest runtime uses Supabase repositories (and upserts POC seed config).
# Without them, process-local in-memory stores are used (tests / offline demo).

# App
NEXT_PUBLIC_APP_NAME=FHIR NOA Accelerator
